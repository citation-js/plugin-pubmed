{
  "name": "@citation-js/plugin-pubmed",
  "version": "0.4.0",
  "type": "module",
  "description": "Citation.js plugin for PubMed and PubMed Central.",
  "main": "src/index.js",
  "types": "index.d.ts",
  "scripts": {
    "test": "node --test --test-reporter spec test/suite.js",
    "lint": "standard \"src/**/*.js\" \"test/**/*.js\"",
    "type-check": "tsc --noEmit test/types.ts",
    "changelog": "conventional-changelog -p angular && git add CHANGELOG.md",
    "coverage": "c8 npm test",
    "report": "c8 report --reporter=lcov",
    "preversion": "npm run lint && npm run type-check && npm run test",
    "version": "npm run changelog"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/citation-js/plugin-pubmed.git"
  },
  "keywords": [
    "PubMed",
    "PubMed Central"
  ],
  "author": "Egon Willighagen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/citation-js/plugin-pubmed/issues"
  },
  "homepage": "https://github.com/citation-js/plugin-pubmed#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "/src",
    "/index.d.ts"
  ],
  "devDependencies": {
    "@citation-js/core": "^0.9.0",
    "c8": "^12.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "standard": "^17.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@citation-js/core": ">=0.5.1 <1.0"
  }
}
